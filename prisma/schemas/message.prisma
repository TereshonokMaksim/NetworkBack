model Message {
  id             Int          @id @default(autoincrement())
  text           String?
  created_at     DateTime        @db.Timestamptz(6)
  chatId         Int          @map("chat_id")
  senderId       Int?         @map("sender_id")
  chat           Chat            @relation(fields: [chatId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chat_app_message_chat_id_a7824698_fk_chat_app_chat_id")
  sender         User?           @relation("sender_user", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chat_app_message_sender_id_03c5fae9_fk_user_app_user_id")
  messageReaders MessageReader[]
  messageImages  MessageImage[]

  @@index([chatId], map: "chat_app_message_chat_id_a7824698")
  @@index([senderId], map: "chat_app_message_sender_id_03c5fae9")
  @@map("chat_app_message")
}
