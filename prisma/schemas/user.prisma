model User {
  id               Int             @id @default(autoincrement())
  name             String?
  surname          String?
  username         String?
  password         String
  email            String
  profile          Profile?
  posts            Post[]
  postHearts       PostHeart[]
  postLikes        PostLike[]
  postViews        PostView[]
  messages         Message[]       @relation(name: "sender_user")
  chats            Chat[]          @relation(name: "chat_admin")
  from_friendShips FriendShip[]    @relation(name: "from_user_user")
  to_friendShips   FriendShip[]    @relation(name: "to_user_user")
  chatUsers        ChatUser[]
  messageReaders   MessageReader[]

  @@map(name: "user_app_user")
}