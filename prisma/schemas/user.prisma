model User {
  id               Int              @id @default(autoincrement())
  name             String?
  surname          String?
  nickname         String?
  username         String?
  password         String
  email            String
  birthday         String?
  currentAvatar    Avatar?  @relation(fields: [currentAvatarId], references: [id], name: "currentUserAvatar")
  currentAvatarId  Int?     @unique
  avatars          Avatar[] @relation(name: "userAvatar")
  showNickname     Boolean  @default(false)
  signature        Image?   @relation(fields: [signatureImageId], references: [id], name: "signatureImage")
  signatureImageId Int?     @unique
  showSignature    Boolean  @default(false)
  online           Boolean  @default(false)
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  isAdmin          Boolean  @default(false)
  albums           Album[]
}
