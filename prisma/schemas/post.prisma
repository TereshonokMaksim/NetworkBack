model Post {
  id           Int              @id @default(autoincrement())
  author       User             @relation(fields: [authorId], references: [id], name: "userPost")
  authorId     Int
  title        String
  topic        String
  text         String
  likes        Int              @default(0)
  hearted      Int              @default(0)
  watched      Int              @default(0)
  tags         PostTag[]        
  links        PostLink[]
  images       Image[]          @relation(name: "postImage")
  userStatuses UserPostStatus[] @relation(name: "postStatus")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
