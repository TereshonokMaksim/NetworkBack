model Profile {
  id                 Int     @id @default(autoincrement())
  user               User    @relation(fields: [userId], references: [id])
  userId             Int     @unique @map(name: "user_id")
  pseudonym          String?
  birth_date         String?
  signature          String?
  is_image_signature Boolean @default(false)
  is_text_signature  Boolean @default(false)
  avatar             String?
  albums             Album[]

  @@map(name: "profile_app_profile")
}