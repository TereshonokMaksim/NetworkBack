model Image {
  id                  Int          @id @default(autoincrement())
  originalImagePath   String
  compressedImagePath String?
  createdAt           DateTime     @default(now())
  avatar              Avatar?      @relation(name: "userImage")
  signature           User?        @relation(name: "signatureImage")
  albums              Album[]
  albumImages         AlbumImage[]
  postOriginal        Post?        @relation(fields: [postOriginalId], references: [id], name: "postImage")
  postOriginalId      Int?
}
