model PostTag {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id])
  postId Int  @map(name: "post_id")
  tag    Tag  @relation(fields: [tagId], references: [id])
  tagId  Int  @map(name: "tag_id")

  @@unique([postId, tagId])
  @@map(name: "post_app_post_tags")
}